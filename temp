.post__card {
  gap: 0.75rem;
}
.post__card--image {
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border-radius: 1rem;
}
.post__card--title {
  font-size: 13px;
  font-weight: 500;
  margin: 0;
  padding: 0;
  line-height: 1.8em;
  margin-bottom: 10px;
  font-weight: 500;
}
.post__card--title a {
  display: block;
}
.post__card--body .desc {
  line-height: 1.8em;
  font-size: 12px;
  opacity: .8;
  min-height: 95px;
}
.post_date {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 12px;
}
.post_meta hr {
  border-style: dashed;
  flex-grow: 1;
}
.post_meta .read_more {
  border-style: dashed;
  flex-grow: 1;
}

