<div>
  <form class="p-4 bg-white shadow-sm rounded-3 row g-3">
    <div class="col-12 col-lg-6">
      <label hidden for="name" class="form-label">نام</label>
      <input
        type="text"
        class="form-control font-sm"
        id="name"
        placeholder="نام"
      />
    </div>
    <div class="col-12 col-lg-6">
      <label hidden for="email" class="form-label">ایمیل</label>
      <input
        type="email"
        class="form-control text-start font-sm"
        id="email"
        placeholder="ایمیل"
      />
    </div>

    <div class="col-12">
      <label hidden for="contentText" class="form-label">متن دیدگاه</label>
      <textarea
        class="form-control font-sm"
        id="contentText"
        rows="4"
        placeholder="متن دیدگاه"
      ></textarea>
    </div>

    <div class="col-12">
      <button class="btn btn-dark font-sm">ارسال</button>
    </div>
  </form>
</div>
